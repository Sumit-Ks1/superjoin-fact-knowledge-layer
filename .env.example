# ===========================================================================
# Fact Knowledge Layer — environment
#
# Copy to .env.local and fill in. See SETUP.md for where each value comes from.
#
# REQUIRED marks the four values the app cannot start without. Everything else
# has a working default or degrades cleanly — `GET /api/health` reports exactly
# what is missing and what it costs you.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase — the entire backend: Postgres + pgvector + Storage
# Dashboard → Project Settings → Data API  (URL)
# Dashboard → Project Settings → API Keys  (service_role)
# ---------------------------------------------------------------------------

# REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# REQUIRED. Server-only — bypasses row-level security. Never expose to the
# browser, never commit. Uploads are signed with this and PUT straight to
# Storage, which is why no anon key is needed.
SUPABASE_SERVICE_ROLE_KEY=

# Created automatically on first upload if it does not exist.
SUPABASE_STORAGE_BUCKET=documents

# ---------------------------------------------------------------------------
# Corpus isolation
#
# A corpus is the comparison boundary: linking runs across everything inside
# one and never reaches outside it. Uploads land here when the request does not
# name a corpus.
#
# This matters if local development and production share one Supabase project.
# Left at "default" in both, your test PDFs end up in the same corpus as real
# uploads — and are then *compared against them*, so a user's findings quietly
# include comparisons with your sample files. Set this to something like
# local-dev locally and leave it unset in production.
# ---------------------------------------------------------------------------
DEFAULT_CORPUS_SLUG=default

# ---------------------------------------------------------------------------
# Postgres. Two connection strings, and the difference matters.
# Dashboard → Connect
# ---------------------------------------------------------------------------

# REQUIRED. Transaction pooler, port 6543 — the one the app uses. `pgbouncer=true`
# is not optional: PgBouncer's transaction mode cannot hold prepared statements,
# and without it queries fail intermittently once Inngest runs steps in parallel.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler, port 5432 — used only by drizzle-kit for migrations. DDL such
# as CREATE EXTENSION cannot run over the transaction pooler. Not needed if you
# apply the migration by pasting it into the Supabase SQL editor.
DIRECT_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Inngest — durable orchestration. Read directly by the Inngest SDK, not by
# src/lib/env.ts, so they are absent from /api/health.
#
# Leave both blank for local development: `npm run dev:inngest` runs a local
# dev server that needs no keys. They are only required in production.
# Dashboard → Manage → Event Keys / Signing Key
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Model providers. Gemini is primary, Groq is the failover — different vendor,
# different quota, different outage.
#
# Both optional. With neither, the system still parses documents, reads every
# table deterministically, normalises units and periods, and runs all four
# linking channels. What you lose is facts extracted from prose, and the
# model-assisted document profile. Nothing breaks; less is found.
# ---------------------------------------------------------------------------

# aistudio.google.com/apikey — free tier, also provides embeddings.
GOOGLE_API_KEY=

# console.groq.com/keys — free tier. Failover only; no embeddings.
GROQ_API_KEY=

LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=gemini-embedding-001

# Changing this requires a migration — it is a column type, not a runtime knob.
EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Tuning. Every one is optional and the defaults are sensible.
# ---------------------------------------------------------------------------

# Concurrent model calls per function invocation. Raise only if your quota
# allows; the free tiers rate-limit aggressively.
LLM_MAX_CONCURRENCY=3
LLM_MAX_ATTEMPTS=4

# Work per serverless invocation. The platform sets this ceiling, not the
# algorithm: Vercel's free tier stops a function after 60 seconds, so a long
# document is processed in slices with Inngest carrying state between them.
# Lower these if you see FUNCTION_INVOCATION_TIMEOUT; raise them on a paid plan.
PARSE_PAGE_BATCH=20
EXTRACT_TABLE_BATCH=12
EXTRACT_CHUNK_BATCH=8
EMBED_FACT_BATCH=300

# Upload ceilings. Anyone may upload anything, so these are explicit rather
# than implicit in whatever the function happens to survive.
MAX_UPLOAD_BYTES=52428800
MAX_UPLOAD_PAGES=500

# Pages sampled when deciding whether a PDF has a usable text layer.
TEXT_LAYER_PROBE_PAGES=6