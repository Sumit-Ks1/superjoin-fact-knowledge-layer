# ===========================================================================
# Secrets — nothing here may ever reach a commit.
#
# `.env*` covers every variant, including .env.production and .env.development,
# which the narrower `.env*.local` pattern silently lets through. The negation
# below re-admits the one file that is meant to be shared: the template with
# no values in it.
# ===========================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# ===========================================================================
# Dependencies and build output — regenerated by `npm install` / `npm run build`
# ===========================================================================
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo

# Generated by Next.js on every dev/build; recreated automatically.
next-env.d.ts

# ===========================================================================
# Deployment and tooling caches
# ===========================================================================
.vercel
.inngest/

# Supabase CLI working state. The migrations directory itself MUST be
# committed — it is how anyone else creates the schema — so this is scoped
# tightly rather than ignoring `supabase/`.
supabase/.temp/
supabase/.branches/

# ===========================================================================
# Test and coverage output
# ===========================================================================
coverage/
.nyc_output/
*.lcov

# ===========================================================================
# Logs
# ===========================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===========================================================================
# Editors and operating systems
# ===========================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ===========================================================================
# Scratch space
#
# Debug harnesses are prefixed with an underscore while they are throwaway;
# the ones worth keeping (demo.ts, parse-debug.ts) are not.
# ===========================================================================
scripts/_*.ts
tmp/
temp/
*.local.json

# ===========================================================================
# The assignment brief itself.
#
# It is the company's document, not part of what was built. Publishing it in a
# public repository redistributes their material. Delete this line if you have
# been asked to include it.
# ===========================================================================
superjoin-vit-2026-assignment.pdf
READING-THE-UI.md
SETUP.md